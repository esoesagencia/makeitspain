rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Author avatars: any authenticated user can read; write restricted to signed-in users
    // (admin panel is already behind auth, so this is sufficient)
    match /authors/{authorId}/{fileName} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
